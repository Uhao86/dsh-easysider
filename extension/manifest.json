{
  "manifest_version": 3,
  "name": "DSH EasySider",
  "short_name": "EasySider",
  "version": "0.1.0",
  "description": "DSH EasySider：基于 dsh web profile 的 Chrome 超级侧边栏，支持阅读、问答和浏览器操作。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 DSH EasySider",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "contextMenus",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "打开 DSH EasySider"
    }
  }
}
